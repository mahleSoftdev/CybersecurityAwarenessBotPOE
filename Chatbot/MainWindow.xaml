<Window x:Class="Chatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness Bot" Height="750" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">
    <!--Getting window resoures-->
    <Window.Resources>
        <SolidColorBrush x:Key="ColourPrimary"    Color="#00FFFF"/>
        <SolidColorBrush x:Key="ColourDarkCyan"   Color="#008B8B"/>
        <SolidColorBrush x:Key="ColourAccent"     Color="#00FF7F"/>
        <SolidColorBrush x:Key="ColourWarning"    Color="#FFD700"/>
        <SolidColorBrush x:Key="ColourSubtle"     Color="#B8860B"/>
        <SolidColorBrush x:Key="ColourError"      Color="#FF4444"/>
        <SolidColorBrush x:Key="ColourBackground" Color="#0D1117"/>
        <SolidColorBrush x:Key="ColourPanel"      Color="#161B22"/>
        <SolidColorBrush x:Key="ColourBorder"     Color="#30363D"/>
        <SolidColorBrush x:Key="ColourInput"      Color="#1C2128"/>

        <!-- Button styling -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#008B8B"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">

                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}" Margin="0,-3,16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00FFFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005F5F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick-topic button styling -->
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="Turquoise"/>
            <Setter Property="FontFamily" Value="Impact"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Turquoise"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox styling -->
        <Style x:Key="CyberTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="Turquoise"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SelectionBrush" Value="Turquoise"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                            <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Turquoise"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Width" Value="20"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ASCII -->
            <RowDefinition Height="Auto"/>
            <!-- Name entry -->
            <RowDefinition Height="*"/>
            <!-- Chat area -->
            <RowDefinition Height="Auto"/>
            <!-- Quick-topic buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Input row -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!--Grid styling-->
        <Border Grid.Row="0" Background="Black"
                BorderBrush="Turquoise" BorderThickness="0,0,0,2"
                Padding="20,15">
            <StackPanel>
                <!--AI Assisted -->
                <TextBlock FontFamily="Impact" FontSize="10"
                           Foreground="MediumTurquoise" TextWrapping="NoWrap"
                           HorizontalAlignment="Center"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight" RenderTransformOrigin="0.5,0.5">
                    
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                   ██████╗██╗   ██╗██████╗ ███████╗██████╗      ██████╗  ██████╗ ████████╗&#xA;  ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗    ██╔══██╗██╔═══██╗╚══██╔══╝&#xA;  ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝    ██████╔╝██║   ██║   ██║&#xA;  ██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗    ██╔══██╗██║   ██║   ██║&#xA;  ╚██████╗   ██║   ██████╔╝███████╗██║  ██║    ██████╔╝╚██████╔╝   ██║&#xA;   ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝   ╚═════╝  ╚═════╝    ╚═╝
                </TextBlock>
                <TextBlock Text="🔒  Cybersecurity Awareness Assistant  🔒"
                           FontFamily="Impact" FontSize="50" FontWeight="Bold"
                           Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="──────────────────────────────────────────────────"
                           FontFamily="Impact" FontSize="20" FontWeight="Bold"
                           Foreground="Orange" HorizontalAlignment="Center"/>
                <TextBlock Text="Helping South Africans stay safe online."
                           FontFamily="Impact" FontSize="25"
                           Foreground="Orange" HorizontalAlignment="Center"/>
            </StackPanel>
            
        </Border>

        <Border Grid.Row="1" x:Name="NamePanel"
                Background="#1C2128" BorderBrush="#30363D" BorderThickness="0,0,0,1"
                Padding="30,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBlock Text="Before we begin — what's your name?  "
                           FontFamily="Impact"
                           FontSize="20"
                           Foreground="#FFD700" 
                           VerticalAlignment="Center"/>
                 <!--Ai assisted-->
                <TextBox x:Name="NameBox"
                 Width="180"
                 Height="32"
                 Style="{StaticResource CyberTextBox}"
                 VerticalContentAlignment="Center"
                 KeyDown="NameBox_KeyDown"
                 />




                <Button Content="  Start Chat  " Margin="10,0,0,0" Height="32"
                        Style="{StaticResource CyberButton}"
                        Click="StartChat_Click"/>
            </StackPanel>
        </Border>

        <!--Chat Area-->
        <Border Grid.Row="2" Background="#0D1117"
                BorderBrush="#30363D" BorderThickness="1" Margin="10,8">
            <ScrollViewer x:Name="ChatScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
                <StackPanel x:Name="ChatPanel" Margin="10,8" />
            </ScrollViewer>
        </Border>

        <!--QUICK-TOPIC Buttons-->
        <Border Grid.Row="3" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="0,1,0,1"
                Padding="10,6">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="🔑 Passwords"   Style="{StaticResource QuickButton}" Tag="password"   Click="Chip_Click"/>
                <Button Content="🎣 Phishing"    Style="{StaticResource QuickButton}" Tag="phishing"   Click="Chip_Click"/>
                <Button Content="💳 Scams"       Style="{StaticResource QuickButton}" Tag="scam"       Click="Chip_Click"/>
                <Button Content="🕵️ Privacy"    Style="{StaticResource QuickButton}" Tag="privacy"    Click="Chip_Click"/>
                <Button Content="🦠 Malware"     Style="{StaticResource QuickButton}" Tag="malware"    Click="Chip_Click"/>
                <Button Content="🔐 2FA"         Style="{StaticResource QuickButton}" Tag="2fa"        Click="Chip_Click"/>
                <Button Content="📶 Public Wi-Fi" Style="{StaticResource QuickButton}" Tag="public wifi" Click="Chip_Click"/>
                <Button Content="💾 Backups"     Style="{StaticResource QuickButton}" Tag="backup"     Click="Chip_Click"/>
                <Button Content="🧠 Social Eng." Style="{StaticResource QuickButton}" Tag="social engineering" Click="Chip_Click"/>
                <Button Content="🌐 Browsing"    Style="{StaticResource QuickButton}" Tag="safe browsing" Click="Chip_Click"/>
                <Button Content="❓ Help"         Style="{StaticResource QuickButton}" Tag="help"            Click="Chip_Click"/>
                <Button Content="📋 My Tasks"   Style="{StaticResource QuickButton}" Tag="show tasks"      Click="Chip_Click"/>
                <Button Content="🎮 Quiz"        Style="{StaticResource QuickButton}" Tag="quiz"            Click="Chip_Click"/>
                <Button Content="📜 Activity Log" Style="{StaticResource QuickButton}" Tag="show activity log" Click="Chip_Click"/>
            </WrapPanel>
        </Border>


        <Grid Grid.Row="4" Margin="10,6,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!--User input textbox-->
            <TextBox x:Name="InputBox" Grid.Column="0"
                     Style="{StaticResource CyberTextBox}"
                     Height="36" VerticalContentAlignment="Center"
                     IsEnabled="False"
                     KeyDown="InputBox_KeyDown"
                     TextChanged="InputBox_TextChanged"/>

            <Button x:Name="SendButton" Grid.Column="1"
                    Content="  Send  " Margin="8,0,0,0" Height="36"
                    Style="{StaticResource CyberButton}"
                    IsEnabled="False"
                    Click="Send_Click"/>
            <Button x:Name="ClearButton" Grid.Column="2"
                    Content="Clear" Margin="6,0,0,0" Height="36"
                    Style="{StaticResource CyberButton}"
                    Background="#30363D"
                    Click="Clear_Click"/>
        </Grid>

        <!--chat status(AI Assisted addition)-->
        <Border Grid.Row="5" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="0,1,0,0"
                Padding="14,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBar" Grid.Column="0"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#B8860B"
                           Text="Enter your name above to begin."/>
                <TextBlock x:Name="TopicLabel" Grid.Column="1"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#008B8B"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
